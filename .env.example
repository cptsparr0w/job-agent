# Local Qwen via LM Studio (OpenAI-compatible endpoint)
QWEN_BASE_URL=http://localhost:1234/v1
QWEN_MODEL=qwen3-30b-a3b-instruct        # whatever LM Studio reports

# Optional: separate vision model for unknown-form fallback
# (load Qwen2.5-VL or similar in LM Studio, then set this)
# QWEN_VISION_MODEL=qwen2.5-vl-7b-instruct

# DB
DB_PATH=./data/job-agent.db

# Logging
LOG_LEVEL=INFO

# --- Optional cloud fallback ---
# Uncomment and install with `pip install -e ".[claude]"` to enable a
# Claude tier. Not required for the default all-local setup.
# ANTHROPIC_API_KEY=sk-ant-...
